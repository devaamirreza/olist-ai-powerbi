table Orders
	lineageTag: 0c39bbc0-1485-47bd-aa51-284e71c4056d

	measure 'Total Orders' = DISTINCTCOUNT('Orders'[order_id])
		formatString: #,##0
		lineageTag: afec5f05-c822-47a6-913b-e739adef208f

	measure 'Total Customers' = DISTINCTCOUNT('Orders'[customer_unique_id])
		formatString: #,##0
		lineageTag: c4010269-2cb3-4d66-95d6-2699f6ca1d60

	measure 'Average Delivery Days' = AVERAGE('Orders'[DeliveryDays])
		formatString: 0.0
		lineageTag: 67b0a027-2463-403c-a89c-e2f9d9118524

	measure 'On Time Delivery %' =
			DIVIDE(
			    CALCULATE(
			        DISTINCTCOUNT('Orders'[order_id]),
			        'Orders'[DeliveryPerformance] = "On Time"
			    ),
			    CALCULATE(
			        DISTINCTCOUNT('Orders'[order_id]),
			        'Orders'[DeliveryStatus] = "Delivered"
			    )
			)
		formatString: 0.0%
		lineageTag: 3d81aaaf-88c1-4174-9329-a0a860fe65bc

	measure 'Repeat Customer Rate' =
			VAR CustomerOrderCounts =
			    ADDCOLUMNS(
			        FILTER(
			            VALUES('Orders'[customer_unique_id]),
			            NOT ISBLANK('Orders'[customer_unique_id])
			        ),
			        "@OrderCount", CALCULATE(DISTINCTCOUNT('Orders'[order_id]))
			    )
			RETURN
			    DIVIDE(
			        COUNTROWS(FILTER(CustomerOrderCounts, [@OrderCount] > 1)),
			        COUNTROWS(CustomerOrderCounts)
			    )
		formatString: 0.0%
		lineageTag: e6e90d7f-8ef7-4e26-8405-a83eb707b700

	measure 'Canceled / Unavailable Order Rate' =
			DIVIDE(
			    CALCULATE(
			        [Total Orders],
			        'Orders'[order_status] IN { "canceled", "unavailable" }
			    ),
			    [Total Orders]
			)
		formatString: 0.0%
		lineageTag: 4ad76beb-f211-4b6c-b5a8-f6516fafeb11

	measure 'Average Days Late' =
			AVERAGEX(
			    FILTER(
			        'Orders',
			        'Orders'[DeliveryStatus] = "Delivered"
			            && NOT ISBLANK('Orders'[CustomerDeliveryDate])
			            && NOT ISBLANK('Orders'[EstimatedDeliveryDate])
			            && 'Orders'[CustomerDeliveryDate] > 'Orders'[EstimatedDeliveryDate]
			    ),
			    DATEDIFF(
			        'Orders'[EstimatedDeliveryDate],
			        'Orders'[CustomerDeliveryDate],
			        DAY
			    )
			)
		formatString: 0.0
		lineageTag: 66ef6b0a-33c1-4057-9a07-d19a765b3524

