	partition Orders = m
		mode: import
		source =
				let
				    Source = Csv.Document(
				        File.Contents("C:\Users\iamaa\Downloads\olist-ai-powerbi\data\raw\olist_orders_dataset.csv"),
				        [Delimiter = ",", Columns = 8, QuoteStyle = QuoteStyle.None]
				    ),
				
				    #"Promoted Headers" = Table.PromoteHeaders(
				        Source,
				        [PromoteAllScalars = true]
				    ),
				
				    #"Changed Column Types" = Table.TransformColumnTypes(
				        #"Promoted Headers",
				        {
				            {"order_id", type text},
				            {"customer_id", type text},
				            {"order_status", type text},
				            {"order_purchase_timestamp", type datetime},
				            {"order_approved_at", type datetime},
				            {"order_delivered_carrier_date", type datetime},
				            {"order_delivered_customer_date", type datetime},
				            {"order_estimated_delivery_date", type datetime}
				        },
				        "en-US"
				    ),
				
				    #"Added DeliveryDays" = Table.AddColumn(
				        #"Changed Column Types",
				        "DeliveryDays",
				        each
				            if [order_delivered_customer_date] = null then
				                null
				            else
				                Duration.Days(
				                    [order_delivered_customer_date] - [order_purchase_timestamp]
				                ),
				        Int64.Type
				    ),
				
				    #"Added DeliveryStatus" = Table.AddColumn(
				        #"Added DeliveryDays",
				        "DeliveryStatus",
				        each
				            if [order_delivered_customer_date] = null then
				                "Not Delivered"
				            else
				                "Delivered",
				        type text
				    ),
				
				    #"Added DeliveryPerformance" = Table.AddColumn(
				        #"Added DeliveryStatus",
				        "DeliveryPerformance",
				        each
				            if [order_delivered_customer_date] = null then
				                "Not Delivered"
				            else if [order_delivered_customer_date] <= [order_estimated_delivery_date] then
				                "On Time"
				            else
				                "Late",
				        type text
				    ),
				
				    #"Renamed Columns" = Table.RenameColumns(
				        #"Added DeliveryPerformance",
				        {
				            {"order_purchase_timestamp", "PurchaseDateTime"},
				            {"order_approved_at", "ApprovedDateTime"},
				            {"order_delivered_carrier_date", "CarrierDeliveryDate"},
				            {"order_delivered_customer_date", "CustomerDeliveryDate"},
				            {"order_estimated_delivery_date", "EstimatedDeliveryDate"}
				        }
				    ),
				
				    #"Added PurchaseDate" = Table.AddColumn(
				        #"Renamed Columns",
				        "PurchaseDate",
				        each Date.From([PurchaseDateTime]),
				        type date
				    ),
				
				    #"Merged Customers" = Table.NestedJoin(
				        #"Added PurchaseDate",
				        {"customer_id"},
				        Customers,
				        {"customer_id"},
				        "CustomerLookup",
				        JoinKind.LeftOuter
				    ),
				
				    #"Expanded Customer Unique ID" = Table.ExpandTableColumn(
				        #"Merged Customers",
				        "CustomerLookup",
				        {"customer_unique_id"},
				        {"customer_unique_id"}
				    )
				
				in
				    #"Expanded Customer Unique ID"

	annotation PBI_ResultType = Table

