table Reviews
	lineageTag: 19e3564c-72b7-4196-8cea-37cf9d5bac2b

	measure 'Average Review Score' = AVERAGE('Reviews'[ReviewScore])
		formatString: 0.00
		lineageTag: 3d8c7525-6184-42e5-9ab3-9e78fcc01334

	column review_id
		dataType: string
		lineageTag: fa61d735-1275-4a09-b88b-e7b1a7829f99
		summarizeBy: none
		sourceColumn: review_id

		annotation SummarizationSetBy = Automatic

	column order_id
		dataType: string
		lineageTag: cd3000bc-b7a0-4423-a390-a710060a490c
		summarizeBy: none
		sourceColumn: order_id

		annotation SummarizationSetBy = Automatic

	column ReviewScore
		dataType: int64
		formatString: 0
		lineageTag: b3196ee7-711c-44db-acf9-0deea173ddc8
		summarizeBy: sum
		sourceColumn: ReviewScore

		annotation SummarizationSetBy = Automatic

	column ReviewCommentTitle
		dataType: string
		lineageTag: 27c28e57-e9e4-4e90-9fe4-39ed59f9b288
		summarizeBy: none
		sourceColumn: ReviewCommentTitle

